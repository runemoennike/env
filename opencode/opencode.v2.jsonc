{
  "$schema": "https://opencode.ai/config.json",

  // Multi-agent setup: architect -> (researcher | coder -> reviewer).
  // System prompts live in ./prompts/*.md next to this file.
  // The global permission floor also protects built-in agents; per-agent rules
  // are appended and the last matching rule wins.
  "default_agent": "architect",
  "experimental": {
    // Let coder (a subagent) consult researcher; enable todos for all agents.
    "subagent_depth": 2,
    "todo": true
  },
  // v2 uses EXA_API_KEY for researcher web searches.
  "websearch": { "provider": "exa" },
  "providers": {
    "github-copilot": {
      "models": {
        "gpt-6.1-terra": {
          "variants": [
            { "id": "medium", "settings": { "reasoningEffort": "medium" } }
          ]
        }
      }
    }
  },

  // GLOBAL PERMISSION FLOOR: v2 otherwise allows external directories. Ask for
  // unlisted paths, then allow the paths derived from the permission audit.
  // Git commands are denied in plain and global-option-prefix forms.
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "C:/tools/neovim/**", "effect": "allow" },
    { "action": "external_directory", "resource": "C:/Program Files/Neovim/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/AppData/Local/nvim-data/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.nuget/packages/**", "effect": "allow" },
    { "action": "external_directory", "resource": "D:/PackageCaches/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/AppData/Local/Temp/opencode/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/AppData/Local/Temp/OfficeAddins.log.txt", "effect": "allow" },
    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "shell", "resource": "git -* push*", "effect": "deny" },
    { "action": "shell", "resource": "git reset*--hard*", "effect": "deny" },
    { "action": "shell", "resource": "git -*reset*--hard*", "effect": "deny" },
    { "action": "shell", "resource": "git clean*", "effect": "deny" },
    { "action": "shell", "resource": "git -* clean*", "effect": "deny" }
  ],

  "agents": {
    // ARCHITECT - primary; plans only and delegates implementation.
    "architect": {
      "mode": "primary",
      "description": "Turns feature requests and change requests into an approved, executable plan, then orchestrates the researcher, coder and reviewer subagents.",
      "model": "github-copilot/claude-opus-5.5",
      "system": "{file:./prompts/architect.md}",
      "color": "#5c9cf5",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        // Read-only shell investigation; deny everything else without prompting.
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "Get-ChildItem*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Content*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Item*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Member*", "effect": "allow" },
        { "action": "shell", "resource": "Test-Path*", "effect": "allow" },
        { "action": "shell", "resource": "Select-String*", "effect": "allow" },
        { "action": "shell", "resource": "Measure-Object*", "effect": "allow" },
        { "action": "shell", "resource": "Select-Object*", "effect": "allow" },
        { "action": "shell", "resource": "Sort-Object*", "effect": "allow" },
        { "action": "shell", "resource": "Group-Object*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Unique*", "effect": "allow" },
        { "action": "shell", "resource": "Compare-Object*", "effect": "allow" },
        { "action": "shell", "resource": "Format-Table*", "effect": "allow" },
        { "action": "shell", "resource": "Format-List*", "effect": "allow" },
        { "action": "shell", "resource": "Format-Wide*", "effect": "allow" },
        { "action": "shell", "resource": "Out-String*", "effect": "allow" },
        { "action": "shell", "resource": "Resolve-Path*", "effect": "allow" },
        { "action": "shell", "resource": "Split-Path*", "effect": "allow" },
        { "action": "shell", "resource": "Join-Path*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Location*", "effect": "allow" },
        { "action": "shell", "resource": "ConvertFrom-Json*", "effect": "allow" },
        { "action": "shell", "resource": "ConvertTo-Json*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Command*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Help*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Module*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Alias*", "effect": "allow" },
        { "action": "shell", "resource": "ls*", "effect": "allow" },
        { "action": "shell", "resource": "cat*", "effect": "allow" },
        { "action": "shell", "resource": "pwd*", "effect": "allow" },
        { "action": "shell", "resource": "rg *", "effect": "allow" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "git log*", "effect": "allow" },
        { "action": "shell", "resource": "git show*", "effect": "allow" },
        { "action": "shell", "resource": "git branch*", "effect": "allow" },
        { "action": "shell", "resource": "git blame*", "effect": "allow" },
        { "action": "shell", "resource": "git rev-parse*", "effect": "allow" },
        { "action": "shell", "resource": "git merge-base*", "effect": "allow" },
        { "action": "shell", "resource": "git ls-files*", "effect": "allow" },
        // Web access belongs to researcher alone within this set.
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        // The three specialists plus built-in explore.
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "explore", "effect": "allow" },
        { "action": "subagent", "resource": "researcher", "effect": "allow" },
        { "action": "subagent", "resource": "coder", "effect": "allow" },
        { "action": "subagent", "resource": "reviewer", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" }
      ]
    },

    // RESEARCHER - external retrieval only. Local context comes from the caller.
    "researcher": {
      "mode": "subagent",
      "description": "Fetches current API specifications, library documentation, release notes and version details from the internet. Use it when a question cannot be answered from the local repository. Returns a cited brief; does not write code and cannot read local files.",
      "model": "github-copilot/claude-haiku-5.5",
      "system": "{file:./prompts/researcher.md}",
      "color": "#56b6c2",
      "permissions": [
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "deny" },
        { "action": "grep", "resource": "*", "effect": "deny" },
        { "action": "glob", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" }
      ]
    },

    // CODER - implements approved plans. Reasoning effort remains medium;
    // temperature is not set for this reasoning model.
    "coder": {
      "mode": "all",
      "description": "Implements an approved plan: edits files, runs builds and tests. Does not decide scope or design. Give it the full plan, file paths and acceptance criteria, since it starts with no context.",
      "model": "github-copilot/gpt-6.1-terra#medium",
      "system": "{file:./prompts/coder.md}",
      "color": "#7fd88f",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        // Broad rules first; narrow rules last.
        { "action": "shell", "resource": "*", "effect": "ask" },
        // Build/test tooling.
        { "action": "shell", "resource": "dotnet build*", "effect": "allow" },
        { "action": "shell", "resource": "dotnet test*", "effect": "allow" },
        { "action": "shell", "resource": "dotnet restore*", "effect": "allow" },
        { "action": "shell", "resource": "npm run*", "effect": "allow" },
        { "action": "shell", "resource": "npm test*", "effect": "allow" },
        { "action": "shell", "resource": "npm ci*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm*", "effect": "allow" },
        { "action": "shell", "resource": "cargo build*", "effect": "allow" },
        { "action": "shell", "resource": "cargo test*", "effect": "allow" },
        { "action": "shell", "resource": "go build*", "effect": "allow" },
        { "action": "shell", "resource": "go test*", "effect": "allow" },
        { "action": "shell", "resource": "pytest*", "effect": "allow" },
        // Read-only search and PowerShell investigation. Check v2's command
        // splitting before relying on these patterns for chained commands.
        { "action": "shell", "resource": "rg *", "effect": "allow" },
        { "action": "shell", "resource": "Get-ChildItem*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Content*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Item*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Member*", "effect": "allow" },
        { "action": "shell", "resource": "Test-Path*", "effect": "allow" },
        { "action": "shell", "resource": "Select-String*", "effect": "allow" },
        { "action": "shell", "resource": "Measure-Object*", "effect": "allow" },
        { "action": "shell", "resource": "Select-Object*", "effect": "allow" },
        { "action": "shell", "resource": "Sort-Object*", "effect": "allow" },
        { "action": "shell", "resource": "Group-Object*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Unique*", "effect": "allow" },
        { "action": "shell", "resource": "Compare-Object*", "effect": "allow" },
        { "action": "shell", "resource": "Format-Table*", "effect": "allow" },
        { "action": "shell", "resource": "Format-List*", "effect": "allow" },
        { "action": "shell", "resource": "Format-Wide*", "effect": "allow" },
        { "action": "shell", "resource": "Out-String*", "effect": "allow" },
        { "action": "shell", "resource": "Resolve-Path*", "effect": "allow" },
        { "action": "shell", "resource": "Split-Path*", "effect": "allow" },
        { "action": "shell", "resource": "Join-Path*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Location*", "effect": "allow" },
        { "action": "shell", "resource": "ConvertFrom-Json*", "effect": "allow" },
        { "action": "shell", "resource": "ConvertTo-Json*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Command*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Help*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Module*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Alias*", "effect": "allow" },
        { "action": "shell", "resource": "ls*", "effect": "allow" },
        { "action": "shell", "resource": "cat*", "effect": "allow" },
        { "action": "shell", "resource": "pwd*", "effect": "allow" },
        // Additional tooling derived from the permission audit.
        { "action": "shell", "resource": "npm view*", "effect": "allow" },
        { "action": "shell", "resource": "npm ls*", "effect": "allow" },
        { "action": "shell", "resource": "npm --version*", "effect": "allow" },
        { "action": "shell", "resource": "npm install", "effect": "allow" },
        { "action": "shell", "resource": "npx office-addin-manifest", "effect": "allow" },
        { "action": "shell", "resource": "npx office-addin-manifest *", "effect": "allow" },
        { "action": "shell", "resource": "dotnet nuget locals*", "effect": "allow" },
        { "action": "shell", "resource": "dotnet --info*", "effect": "allow" },
        { "action": "shell", "resource": "dotnet --list-sdks*", "effect": "allow" },
        { "action": "shell", "resource": "node --version*", "effect": "allow" },
        { "action": "shell", "resource": "python --version*", "effect": "allow" },
        { "action": "shell", "resource": "go version*", "effect": "allow" },
        { "action": "shell", "resource": "nvim --version*", "effect": "allow" },
        { "action": "shell", "resource": "luac -v", "effect": "allow" },
        { "action": "shell", "resource": "tokei --version*", "effect": "allow" },
        { "action": "shell", "resource": "where.exe *", "effect": "allow" },
        { "action": "shell", "resource": "Get-Process*", "effect": "allow" },
        { "action": "shell", "resource": "Get-NetTCPConnection*", "effect": "allow" },
        { "action": "shell", "resource": "netstat -ano*", "effect": "allow" },
        { "action": "shell", "resource": "Get-FileHash*", "effect": "allow" },
        { "action": "shell", "resource": "Get-CimInstance*", "effect": "allow" },
        { "action": "shell", "resource": "tar -tf *", "effect": "allow" },
        { "action": "shell", "resource": "stylua*", "effect": "allow" },
        // Git local work is allowed, history rewriting asks, and remote or
        // destructive operations are denied in both plain and prefix forms.
        { "action": "shell", "resource": "git *", "effect": "allow" },
        { "action": "shell", "resource": "git rebase*", "effect": "ask" },
        { "action": "shell", "resource": "git filter-branch*", "effect": "ask" },
        { "action": "shell", "resource": "git filter-repo*", "effect": "ask" },
        { "action": "shell", "resource": "git commit --amend*", "effect": "ask" },
        { "action": "shell", "resource": "git push*", "effect": "deny" },
        { "action": "shell", "resource": "git -* push*", "effect": "deny" },
        { "action": "shell", "resource": "git reset*--hard*", "effect": "deny" },
        { "action": "shell", "resource": "git -*reset*--hard*", "effect": "deny" },
        { "action": "shell", "resource": "git clean*", "effect": "deny" },
        { "action": "shell", "resource": "git -* clean*", "effect": "deny" },
        { "action": "shell", "resource": "rm -rf*", "effect": "deny" },
        { "action": "shell", "resource": "Remove-Item*", "effect": "ask" },
        // Docs go through researcher; only architect talks to the user.
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "explore", "effect": "allow" },
        { "action": "subagent", "resource": "researcher", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "deny" }
      ]
    },

    // REVIEWER - independent second opinion, read-only.
    "reviewer": {
      "mode": "subagent",
      "description": "Performs an independent critical review of code that was just written, using a different model family from the implementer. Reads the git diff and reports findings graded Blocking / Should-fix / Nit. Read-only; never edits.",
      "model": "github-copilot/claude-opus-5.5",
      "system": "{file:./prompts/reviewer.md}",
      "color": "#f5a742",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        // Read-only git, PowerShell and rg, plus dotnet build/test.
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "Get-ChildItem*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Content*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Item*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Member*", "effect": "allow" },
        { "action": "shell", "resource": "Test-Path*", "effect": "allow" },
        { "action": "shell", "resource": "Select-String*", "effect": "allow" },
        { "action": "shell", "resource": "Measure-Object*", "effect": "allow" },
        { "action": "shell", "resource": "Select-Object*", "effect": "allow" },
        { "action": "shell", "resource": "Sort-Object*", "effect": "allow" },
        { "action": "shell", "resource": "Group-Object*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Unique*", "effect": "allow" },
        { "action": "shell", "resource": "Compare-Object*", "effect": "allow" },
        { "action": "shell", "resource": "Format-Table*", "effect": "allow" },
        { "action": "shell", "resource": "Format-List*", "effect": "allow" },
        { "action": "shell", "resource": "Format-Wide*", "effect": "allow" },
        { "action": "shell", "resource": "Out-String*", "effect": "allow" },
        { "action": "shell", "resource": "Resolve-Path*", "effect": "allow" },
        { "action": "shell", "resource": "Split-Path*", "effect": "allow" },
        { "action": "shell", "resource": "Join-Path*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Location*", "effect": "allow" },
        { "action": "shell", "resource": "ConvertFrom-Json*", "effect": "allow" },
        { "action": "shell", "resource": "ConvertTo-Json*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Command*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Help*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Module*", "effect": "allow" },
        { "action": "shell", "resource": "Get-Alias*", "effect": "allow" },
        { "action": "shell", "resource": "ls*", "effect": "allow" },
        { "action": "shell", "resource": "cat*", "effect": "allow" },
        { "action": "shell", "resource": "pwd*", "effect": "allow" },
        { "action": "shell", "resource": "rg *", "effect": "allow" },
        { "action": "shell", "resource": "dotnet build*", "effect": "allow" },
        { "action": "shell", "resource": "dotnet test*", "effect": "allow" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "git log*", "effect": "allow" },
        { "action": "shell", "resource": "git show*", "effect": "allow" },
        { "action": "shell", "resource": "git blame*", "effect": "allow" },
        { "action": "shell", "resource": "git rev-parse*", "effect": "allow" },
        { "action": "shell", "resource": "git merge-base*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" }
      ]
    },

    // EXPLORE - pin the model and repeat git safety denies as a safeguard.
    // Its prompt and mode remain the built-in defaults.
    "explore": {
      "model": "github-copilot/claude-haiku-5.5",
      "permissions": [
        { "action": "shell", "resource": "git push*", "effect": "deny" },
        { "action": "shell", "resource": "git -* push*", "effect": "deny" },
        { "action": "shell", "resource": "git reset*--hard*", "effect": "deny" },
        { "action": "shell", "resource": "git -*reset*--hard*", "effect": "deny" },
        { "action": "shell", "resource": "git clean*", "effect": "deny" },
        { "action": "shell", "resource": "git -* clean*", "effect": "deny" }
      ]
    }
  }
}
